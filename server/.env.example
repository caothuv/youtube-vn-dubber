# File cấu hình — ĐỔI TÊN thành .env rồi điền key của anh vào.
# KHÔNG gửi file .env này cho ai, KHÔNG đưa lên mạng.
# Chỉ DeepSeek/Gemini mới cần key. Unsloth / Ollama / LM Studio chạy local thì để "local".

# --- Dịch: backend LLM mặc định (Unsloth Desktop) ---
LLM_BASE_URL=http://127.0.0.1:8888/v1
LLM_API_KEY=local
# LLM_MODEL để trống = server tự quét model đang mở trên Unsloth.
LLM_MODEL=

# --- DeepSeek API (chỉ cần khi chọn preset DeepSeek trong popup) ---
DEEPSEEK_API_KEY=
# --- Google Gemini (chỉ cần khi chọn preset Gemini) ---
GEMINI_API_KEY=

# --- Giọng đọc ---
# Tên preset VieNeu (vd: Minh Triết, Ngọc Linh, Đoan Trang, Quốc Tuấn...)
TTS_VOICE=Minh Triết
# Muốn clone giọng người nói: đặt đường dẫn file mẫu 3-8 giây (wav/mp3) vào đây,
# ví dụ: CLONE_REF=C:\youtube-vn-dubber\server\custom_voices\giong-mau.wav
CLONE_REF=

# --- Âm lượng gốc khi lồng tiếng (0.15 = còn 15%) ---
DUCK_VOLUME=0.15

# --- Cổng server (mặc định 8000, đổi nếu bị trùng) ---
PORT=8000

# --- Nguồn cập nhật 1 chạm (để trống = tắt kiểm tra cập nhật) ---
# Cách 1: repo GitHub chứa file release, vd: UPDATE_SOURCE=ten-anh/youtube-vn-dubber
# Cách 2: link thẳng tới file version.json, vd: UPDATE_SOURCE=https://example.com/dubber/version.json
UPDATE_SOURCE=
